{
  "main": "artcraftappsmanager",
  "redirect": [
    "artcraftapps",
    "artcraftappsupdater",
    "craftappsmanager",
    "craftappsupdater",
    "getartcraftmanager",
    "getartcraftupdater"
  ],
  "config": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "regex": "^/download/?$|^/download/ArtCraftAppsManager-[^/]*-x64\\.msi$",
        "destination": "{{url}}",
        "type": 302
      },
      {
        "regex": "^/download/x86/?$|^/download/ArtCraftAppsManager-[^/]*-x86\\.msi$",
        "destination": "{{url_x86}}",
        "type": 302
      },
      {
        "regex": "^/download/mac/?$|^/download/ArtCraftAppsManager-[^/]*\\.dmg$",
        "destination": "{{url_mac}}",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      },
      {
        "source": "**/*.@(html|css|js|json)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/@(assets|fonts)/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      }
    ]
  }
}
